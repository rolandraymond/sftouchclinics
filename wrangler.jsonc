{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sf-touch-clinics1",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-09",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}